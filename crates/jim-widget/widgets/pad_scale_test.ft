// pad_scale_test.ft — funct crates/jim-widget/widgets/pad_scale_test.ft
import { x_kind_of, x_kind, y_of, x_value, categories_of, y_domain, y_axis,
         scale, apply_scale, band, band_center, band_start, label_step,
         bin_count, histogram, polyline, area_path, bar_path, arc_path,
         donut_angles } from "pad_scale"

fn check(what, got, want) {
    if got != want { fail("${what}: got ${got}, want ${want}") }
}

fn close(what, got, want, tol) {
    if abs(got - want) > tol { fail("${what}: got ${got}, want ${want} (±${tol})") }
}

fn series(pts) = { points: pts }

fn test_x_kinds() {
    check("number x", x_kind_of(3), "number")
    check("float x", x_kind_of(3.5), "number")
    check("date x", x_kind_of("2026-08-16"), "date")
    check("category x", x_kind_of("us-east"), "category")

    let ok = x_kind([series([[1, 2], [2, 3]])])
    check("uniform numbers ok", ok.ok, true)
    check("uniform kind", ok.kind, "number")

    // Mixed x values are refused with a message that says what was mixed.
    let mixed = x_kind([series([["2026-08-16", 1], ["us-east", 2]])])
    check("mixed rejected", mixed.ok, false)
    if not contains(mixed.error, "mixes") { fail("error should explain: ${mixed.error}") }

    let empty = x_kind([])
    check("no points rejected", empty.ok, false)
}

fn test_y_gaps() {
    // A null y is a gap, not a zero.
    check("null y is a gap", y_of([1, ""]), None)
    check("number y", unwrap_or(y_of([1, 5.5]), -1.0), 5.5)
    let d = y_domain([series([[1, 10], [2, ""], [3, 4]])])
    check("gap ignored in domain lo", d.lo, 4.0)
    check("gap ignored in domain hi", d.hi, 10.0)
    check("domain saw data", d.any, true)
}

fn test_categories() {
    let cats = categories_of([series([["a", 1], ["b", 2]]), series([["b", 3], ["c", 4]])])
    check("union in first-seen order", join(cats, ","), "a,b,c")
    check("x_value indexes categories", x_value("c", "category", cats), 2.0)
}

fn test_y_axis() {
    // Bars include zero so their length means something.
    let bars = y_axis([series([["a", 40], ["b", 55]])], true, "", "", 5)
    check("bar axis starts at zero", bars.min, 0.0)

    // Lines don't: a series that lives at 100±2 shouldn't be flattened.
    let line = y_axis([series([[1, 100], [2, 102]])], false, "", "", 5)
    if line.min <= 0.0 { fail("line axis should not be dragged to zero: ${line.min}") }

    // Explicit bounds win over both rules.
    let forced = y_axis([series([[1, 5]])], true, 2.0, 8.0, 5)
    if forced.min > 2.0 { fail("y_min should hold the floor") }
}

fn test_scales() {
    let sc = scale(0.0, 10.0, 100.0, 200.0)
    close("scale start", apply_scale(sc, 0.0), 100.0, 0.001)
    close("scale end", apply_scale(sc, 10.0), 200.0, 0.001)
    close("scale middle", apply_scale(sc, 5.0), 150.0, 0.001)
    // A flat domain maps to the middle instead of dividing by zero.
    let flat = scale(5.0, 5.0, 0.0, 100.0)
    close("flat domain", apply_scale(flat, 5.0), 50.0, 0.001)

    let b = band(4, 0.0, 400.0, 0.3)
    close("band step", b.step, 100.0, 0.001)
    close("first center", band_center(b, 0), 50.0, 0.001)
    close("last center", band_center(b, 3), 350.0, 0.001)
    close("inner width", b.inner, 70.0, 0.001)
    close("bar start", band_start(b, 0), 15.0, 0.001)
}

fn test_label_step() {
    check("labels fit", label_step([20.0, 24.0], 40.0), 1)
    // Labels wider than their slot get thinned, not overlapped.
    check("labels thinned", label_step([80.0, 90.0], 30.0), 4)
}

fn test_histogram() {
    let h = histogram([1, 2, 3, 4, 5, 6, 7, 8], 4)
    check("bin count honored", len(h.counts), 4)
    check("all values binned", h.counts[0] + h.counts[1] + h.counts[2] + h.counts[3], 8)
    close("lo", h.lo, 1.0, 0.001)
    close("hi", h.hi, 8.0, 0.001)
    // The maximum belongs to the last bin, not to an imaginary extra one.
    let edge = histogram([0, 10], 2)
    check("max lands in the last bin", edge.counts[1], 1)
    // A single repeated value still gets a bar.
    let flat = histogram([5, 5, 5], 3)
    check("flat data still bins", flat.counts[0], 3)
    check("empty histogram", len(histogram([], "").counts), 0)
    // Sturges: 8 values -> 4 bins, 100 -> 8.
    check("sturges small", bin_count(8, ""), 4)
    check("sturges hundred", bin_count(100, ""), 8)
}

fn test_paths() {
    check("one point is not a line", polyline([{ x: 1.0, y: 2.0 }]), "")
    let d = polyline([{ x: 0.0, y: 0.0 }, { x: 10.0, y: 5.0 }])
    check("polyline", d, "M 0.00 0.00 L 10.00 5.00")

    let a = area_path([{ x: 0.0, y: 10.0 }, { x: 10.0, y: 5.0 }], 20.0)
    if not ends_with(a, "Z") { fail("an area must close: ${a}") }
    if not contains(a, "20.00") { fail("an area must reach its baseline: ${a}") }

    // A zero-height bar draws nothing rather than a hairline artifact.
    check("empty bar", bar_path(0.0, 0.0, 10.0, 0.0, 3.0), "")
    let b = bar_path(0.0, 10.0, 20.0, 40.0, 3.0)
    if not contains(b, "Q") { fail("a bar's data end should be rounded: ${b}") }
    // The radius can't exceed half the width, or a thin bar turns into a pill.
    let thin = bar_path(0.0, 0.0, 2.0, 40.0, 8.0)
    if not contains(thin, "Q") { fail("thin bar still rounds: ${thin}") }

    let arc = arc_path(50.0, 50.0, 20.0, 40.0, 0.0, 1.0)
    if not contains(arc, " A ") { fail("a donut segment needs arcs: ${arc}") }
    if not ends_with(arc, "Z") { fail("a donut segment must close: ${arc}") }
    check("degenerate arc", arc_path(0.0, 0.0, 10.0, 20.0, 1.0, 1.0), "")
    // Past half a circle the large-arc flag has to be set.
    let big = arc_path(50.0, 50.0, 20.0, 40.0, 0.0, 4.0)
    if not contains(big, "0 1 1 ") { fail("large sweep needs the large-arc flag: ${big}") }
}

fn test_donut_angles() {
    let d = donut_angles([1, 1, 2])
    check("total", d.total, 4.0)
    check("spans", len(d.spans), 3)
    close("first fraction", d.spans[0].frac, 0.25, 0.0001)
    close("last fraction", d.spans[2].frac, 0.5, 0.0001)
    // Starts at 12 o'clock.
    close("starts at the top", d.spans[0].a0, -1.5707963267948966, 0.0001)
    // The spans tile the full circle without a gap.
    close("full circle", d.spans[2].a1 - d.spans[0].a0, 6.283185307179586, 0.0001)
    // Negative values are dropped rather than drawn backwards.
    let neg = donut_angles([-1, 3])
    close("negative dropped", neg.total, 3.0, 0.0001)
    close("negative has no sweep", neg.spans[0].frac, 0.0, 0.0001)
    check("all-negative draws nothing", len(donut_angles([-1, -2]).spans), 0)
}

fn run() {
    test_x_kinds()
    test_y_gaps()
    test_categories()
    test_y_axis()
    test_scales()
    test_label_step()
    test_histogram()
    test_paths()
    test_donut_angles()
    println("pad_scale: ok")
}

run()
