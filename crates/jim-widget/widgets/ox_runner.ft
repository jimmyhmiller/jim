// ox_runner.ft — live status of the Ox Alpha task runner on the remote box.
//
// The runner lives on computer.jimmyhmiller.com: you drop a markdown task in
// ~/ox-runner/inbox/ and Ox Alpha does the work in an isolated git worktree,
// then pushes a branch. This widget watches it.
//
// Fully event-driven: one long-lived `ssh ... ox stream` child. The remote
// side emits a JSON snapshot line ONLY when something changes (plus a ~20s
// heartbeat), so an idle runner costs nothing here — no set_animating, no
// per-frame polling. on_proc_output wakes us; we re-render once.
import "host"
import { col_text, col_muted, col_accent } from "df"
import { rget } from "git"

let ox_host = "computer.jimmyhmiller.com"
let ox_bin = "/home/jimmyhmiller/ox-runner/bin/ox"
// Snapshot schema this widget needs; see SCHEMA in ox-snapshot.py.
let wanted_schema = 2


fn init_state() = {
    proc: -1,
    connected: false,
    err: "",
    snap: { daemon: "?", model: "", concurrency: 0,
            counts: { waiting: 0, running: 0, done: 0, failed: 0 },
            queued: [], in_flight: [], recent: [] },
    tab: "runs",
    // compose box
    task: "",
    repo: "",
    submit_proc: -1,
    submit_msg: "",
    submit_ok: true,
    respawned: 0,
    retries: 0,
    backoff: 0.0,
}
let state = atom(init_state())

// `state` persists across restarts and hot reloads, so a rehydrated record can
// be missing fields this version added. Merging the defaults underneath means
// adding a field is never a breaking change for an already-open pane.
fn cur() {
    let raw = @state
    if typeof(raw) == "Record" { merge(init_state(), raw) } else { init_state() }
}

// ---- the stream child -------------------------------------------------------

fn start_stream() {
    let s = cur()
    if s.proc != -1 { return }
    // BatchMode: never hang on a password prompt. ServerAlive*: notice a dead
    // link instead of sitting on a silent socket forever.
    let h = proc_spawn("ssh", [
        "-o", "BatchMode=yes",
        "-o", "ServerAliveInterval=15",
        "-o", "ServerAliveCountMax=3",
        "-o", "ConnectTimeout=10",
        ox_host, ox_bin, "stream",
    ])
    if h == -1 {
        // Nothing retries a failed spawn on its own, so arm the backoff timer
        // rather than sitting dead with an error message.
        reset!(state, { ..s, err: "could not spawn ssh; retrying", backoff: 5.0 })
        set_animating(true)
    } else {
        reset!(state, { ..s, proc: h, err: "" })
    }
    request_render()
}

fn on_start() {
    // Process handles do NOT survive a restart or hot reload, but `state` does.
    // A stale `proc` from a previous session made start_stream() early-return
    // forever, so the pane sat with a dead stream and no data. Any handle we
    // rehydrate is invalid by definition — clear it before spawning.
    let s = cur()
    reset!(state, { ..s, proc: -1, submit_proc: -1, connected: false,
                    retries: 0, backoff: 0.0, respawned: 0 })
    start_stream()
}

fn on_proc_output(handle, line) {
    let s = cur()
    if handle == s.submit_proc {
        // `ox enqueue` replies with one JSON line saying what it filed.
        let r = unwrap_or(json_parse(trim(line)), 0)
        if typeof(r) == "Record" {
            let good = rget(r, "ok", false)
            let msg = if good {
                "queued " + rget(r, "task", "") + " -> " + rget(r, "repo", "")
            } else { rget(r, "error", "failed") }
            reset!(state, { ..s, submit_msg: msg, submit_ok: good,
                            task: if good { "" } else { s.task } })
            request_render()
        }
        return
    }
    if handle != s.proc { return }
    let t = trim(line)
    if t == "" { return }
    // The remote emits one complete JSON object per line. json_parse returns
    // an Option, so unwrap before type-checking.
    let parsed = unwrap_or(json_parse(t), 0)
    if typeof(parsed) == "Record" {
        if rget(parsed, "v", 0) < wanted_schema and s.respawned == 0 {
            // Stale `ox stream` on the other end: kill it and start a new one,
            // which picks up the installed script. Once only, so an older
            // runner that genuinely cannot serve this schema does not loop.
            proc_kill(s.proc)
            reset!(state, { ..s, proc: -1, respawned: 1,
                            err: "stream was stale; reconnecting…" })
            request_render()
            start_stream()
            return
        }
        reset!(state, { ..s, snap: parsed, connected: true, err: "", retries: 0, backoff: 0.0 })
        request_render()
    } else {
        // Never swallow unexpected output - stderr noise or a broken remote
        // should be visible, not silently dropped.
        reset!(state, { ..s, err: slice(t, 0, 160) })
        request_render()
    }
}

fn on_proc_exit(handle, code) {
    let s = cur()
    if handle == s.submit_proc {
        // A nonzero exit with no JSON line means ssh itself failed.
        let quiet = s.submit_msg == "sending…"
        reset!(state, { ..s, submit_proc: -1,
                        submit_msg: if quiet {
                            "ssh failed (exit " + str(code) + ")"
                        } else { s.submit_msg },
                        submit_ok: if quiet { false } else { s.submit_ok } })
        request_render()
        return
    }
    if handle != s.proc { return }
    // Back off 2s, 4s, 8s … capped, so a box that is down does not get
    // hammered, and animate only while we are actually waiting to retry.
    let n = s.retries + 1
    let wait = if n <= 1 { 2.0 } else if n == 2 { 4.0 } else if n == 3 { 8.0 } else if n == 4 { 16.0 } else { 30.0 }
    reset!(state, { ..s, proc: -1, connected: false, retries: n, backoff: wait,
                    err: "stream ended (exit " + str(code) + "), retrying in " + str(wait) + "s" })
    set_animating(true)
    request_render()
}


// Only runs while disconnected; start_stream() stops the animation again.
fn on_frame(dt) {
    let s = cur()
    if s.proc != -1 { set_animating(false); return }
    let left = s.backoff - dt
    if left > 0.0 {
        reset!(state, { ..s, backoff: left })
        return
    }
    reset!(state, { ..s, backoff: 0.0, err: "reconnecting…" })
    set_animating(false)
    request_render()
    start_stream()
}

fn on_click(x, y, shift, cmd, id) {
    if id == "reconnect" {
        let s = cur()
        if s.proc != -1 { proc_kill(s.proc) }
        reset!(state, { ..s, proc: -1, connected: false, respawned: 0, err: "reconnecting…" })
        request_render()
        start_stream()
        return
    }
    if id == "queue_task" { submit_task(); return }
    if id == "tab_runs" { let s = cur(); reset!(state, { ..s, tab: "runs" }); request_render(); return }
    if id == "tab_queue" { let s = cur(); reset!(state, { ..s, tab: "queue" }); request_render(); return }
}

// ---- submitting a task ----------------------------------------------------
//
// The body goes down ssh's stdin a line at a time, terminated by a sentinel
// line rather than EOF: the remote `ox enqueue` reads until `__OX_END__`, so
// closing the pipe here would leave it waiting for a line that never comes.

fn submit_task() {
    let s = cur()
    if s.submit_proc != -1 { return }
    if trim(s.task) == "" {
        reset!(state, { ..s, submit_msg: "nothing to send", submit_ok: false })
        request_render()
        return
    }
    if s.repo == "" {
        reset!(state, { ..s, submit_msg: "pick a project first", submit_ok: false })
        request_render()
        return
    }
    let h = proc_spawn("ssh", [
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=10",
        ox_host, ox_bin, "enqueue", "--repo", s.repo,
    ])
    if h == -1 {
        reset!(state, { ..s, submit_msg: "could not spawn ssh", submit_ok: false })
        request_render()
        return
    }
    for line in split(s.task, "\n") { proc_write(h, line) }
    proc_write(h, "__OX_END__")
    reset!(state, { ..s, submit_proc: h, submit_msg: "sending…", submit_ok: true })
    request_render()
}

fn on_input_change(id, value) {
    if id == "task" { let s = cur(); reset!(state, { ..s, task: value }) }
}

// Cmd/Ctrl+Enter in the textarea.
fn on_input_submit(id, value) {
    if id == "task" {
        let s = cur()
        reset!(state, { ..s, task: value })
        submit_task()
    }
}

fn on_select_change(id, value) {
    if id == "repo" {
        let s = cur()
        reset!(state, { ..s, repo: value, submit_msg: "" })
        request_render()
    }
}

// ---- pure helpers -----------------------------------------------------------

fn repo_options(snap) {
    let mut opts = []
    for r in rget(snap, "repos", []) {
        let n = rget(r, "name", "")
        if n != "" { opts = push(opts, { id: n, label: n }) }
    }
    opts
}

fn status_color(st) {
    if st == "success" { "#7fb87f" }
    else if st == "partial" { "#e0b066" }
    else if st == "no-changes" { "#e0b066" }
    else if st == "interrupted" { "#8fa0c0" }
    else { "#e08a8a" }
}

fn dur(secs) {
    if secs < 60 { str(secs) + "s" }
    else if secs < 3600 { str(secs / 60) + "m " + str(secs % 60) + "s" }
    else { str(secs / 3600) + "h " + str((secs % 3600) / 60) + "m" }
}

fn short_run(id) {
    // ids are <date>-<time>-<slug>; the slug is the readable part.
    if len(id) > 16 { slice(id, 16, len(id)) } else { id }
}

fn count_chip(label, n, color) = {
    kind: "hstack", gap: 4.0, align: "center", children: [
        { kind: "text", value: str(n), size: 14.0, weight: "bold", color: color },
        { kind: "text", value: label, size: 11.0, color: col_muted() },
    ]
}

fn inflight_card(r) = {
    kind: "vstack", gap: 2.0, pad: 8.0, children: [
        { kind: "hstack", gap: 8.0, align: "center", children: [
            { kind: "text", value: "▶", size: 12.0, color: "#7fb0e0" },
            { kind: "text", value: rget(r, "repo", "?"), size: 12.0,
              weight: "bold", color: col_text() },
            { kind: "text", value: dur(rget(r, "elapsed", 0)), size: 11.0,
              color: col_muted() },
        ]},
        { kind: "text", value: rget(r, "title", ""), size: 11.0, color: col_text() },
        { kind: "text", value: rget(r, "last", ""), size: 10.0, color: col_muted() },
    ]
}

fn recent_row(r) {
    let st = rget(r, "status", "")
    let pushed = rget(r, "pushed", false)
    let tail = if pushed { rget(r, "branch", "") } else { rget(r, "reason", "") }
    let files = rget(r, "files", 0)
    let churn = if files > 0 {
        str(files) + "f +" + str(rget(r, "insertions", 0)) +
        " -" + str(rget(r, "deletions", 0))
    } else { "" }
    {
        kind: "vstack", gap: 1.0, children: [
            { kind: "hstack", gap: 6.0, align: "center", children: [
                { kind: "text", value: "●", size: 10.0, color: status_color(st) },
                { kind: "text", value: st, size: 11.0, weight: "bold",
                  color: status_color(st) },
                { kind: "text", value: rget(r, "repo", ""), size: 11.0,
                  color: col_text() },
                { kind: "text", value: dur(rget(r, "duration", 0)), size: 10.0,
                  color: col_muted() },
                { kind: "text", value: churn, size: 10.0, color: col_muted() },
            ]},
            { kind: "text", value: slice(tail, 0, 78), size: 10.0,
              color: if pushed { col_accent() } else { col_muted() } },
        ]
    }
}

// ---- render -----------------------------------------------------------------

fn render(w, h) {
    // `on_start` only fires on a FRESH spawn — once this pane has persisted
    // state, jim never calls it again (funct_widget.rs: RESTART seeds state and
    // stops). So the stream cannot be owned by on_start alone or it dies at the
    // first hot reload and never returns. Ensure it here: start_stream() is a
    // no-op while a stream is live, and `backoff` keeps retries paced.
    let s = cur()
    let snap = s.snap
    let counts = rget(snap, "counts", {})
    let daemon = rget(snap, "daemon", "?")
    let dcolor = if daemon == "active" { "#7fb87f" } else { "#e08a8a" }
    let live = s.connected and s.proc != -1

    let inflight = rget(snap, "in_flight", [])
    let recent = rget(snap, "recent", [])
    let queued = rget(snap, "queued", [])

    let mut body = []

    if len(inflight) > 0 {
        body = push(body, { kind: "text", value: "IN FLIGHT", size: 10.0,
                            weight: "bold", color: col_muted() })
        for r in inflight { body = push(body, inflight_card(r)) }
    }

    if s.tab == "queue" {
        body = push(body, { kind: "text", value: "WAITING", size: 10.0,
                            weight: "bold", color: col_muted() })
        if len(queued) == 0 {
            body = push(body, { kind: "text", value: "queue is empty",
                                size: 11.0, color: col_muted() })
        } else {
            for q in queued {
                body = push(body, { kind: "hstack", gap: 8.0, children: [
                    { kind: "text", value: rget(q, "repo", ""), size: 11.0,
                      weight: "bold", color: col_accent() },
                    { kind: "text", value: rget(q, "task", ""), size: 11.0,
                      color: col_text() },
                ]})
            }
        }
    } else {
        if len(recent) == 0 {
            body = push(body, { kind: "text", value: "no runs recorded yet",
                                size: 11.0, color: col_muted() })
        } else {
            body = push(body, { kind: "text", value: "RECENT", size: 10.0,
                                weight: "bold", color: col_muted() })
            for r in recent { body = push(body, recent_row(r)) }
        }
    }

    let status_line = if s.err != "" { s.err }
        else if live { "live" }
        else { "connecting…" }

    {
        kind: "vstack", gap: 8.0, pad: 12.0, children: [
            { kind: "hstack", gap: 10.0, align: "center", children: [
                { kind: "text", value: "ox runner", size: 14.0,
                  weight: "bold", color: col_text() },
                { kind: "text", value: daemon, size: 11.0, color: dcolor },
                { kind: "text", value: rget(snap, "model", ""), size: 10.0,
                  color: col_muted() },
                { kind: "button", id: "reconnect", label: "↻" },
            ]},
            { kind: "hstack", gap: 14.0, align: "center", children: [
                count_chip("waiting", rget(counts, "waiting", 0), col_accent()),
                count_chip("running", rget(counts, "running", 0), "#7fb0e0"),
                count_chip("done", rget(counts, "done", 0), "#7fb87f"),
                count_chip("failed", rget(counts, "failed", 0), "#e08a8a"),
            ]},
            { kind: "hstack", gap: 6.0, children: [
                { kind: "button", id: "tab_runs", label: "runs" },
                { kind: "button", id: "tab_queue", label: "queue" },
            ]},
            { kind: "vstack", gap: 6.0, children: body },
            { kind: "text", value: status_line, size: 10.0,
              color: if s.err != "" { "#e08a8a" } else { col_muted() } },
            { kind: "divider" },
            // Compose sits at the bottom: the run list is what you read, this
            // is what you act with. Full width so long task text stays legible.
            // `style.width` sizes the box, but the wrap calculation in
            // layout.rs still uses the element's own `width`, so set both or
            // the text wraps early inside a full-width box.
            { kind: "textarea", id: "task", value: s.task, rows: 12,
              width: 900.0,
              placeholder: "Describe the task. Cmd+Enter to send.",
              style: { width: "100%" } },
            { kind: "hstack", gap: 8.0, align: "center", children: [
                { kind: "select", id: "repo", value: s.repo, width: 260.0,
                  placeholder: "project…", options: repo_options(snap) },
                { kind: "button", id: "queue_task",
                  label: if s.submit_proc != -1 { "sending…" } else { "Queue" } },
                { kind: "text", value: s.submit_msg, size: 10.0,
                  color: if s.submit_ok { col_muted() } else { "#e08a8a" } },
            ]},
        ]
    }
}
